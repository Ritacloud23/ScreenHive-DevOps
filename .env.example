# Copy to .env on the EC2 instance. Never commit the real file.
POSTGRES_USER=screenhive
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=screenhive
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PAYSTACK_SECRET=
FIRESTORE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/screenhive/dev
ECR_IMAGE=REPLACE_WITH_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/screenhive:latest
